# ── AI answers for Ask MatchMind (OPTIONAL - the rules engine works without it) ──
# The chat uses whichever OpenAI-compatible provider you point it at.
# Pick ONE of these free options:

# Option A: Z.ai (free GLM flash models - you already have a Z.ai account via ZCode)
#   Get a key: https://z.ai / Z.ai console -> API Keys -> create
#   OPENAI_API_KEY=key_xxxxxxxxxxxxxxxx
#   OPENAI_BASE_URL=https://api.z.ai/api/paas/v4
#   OPENAI_MODEL=glm-4.5-flash

# Option B: Google AI Studio (free Gemini tier - no card needed)
#   Get a key: https://aistudio.google.com/apikey
#   OPENAI_API_KEY=AIza...
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OPENAI_MODEL=gemini-2.5-flash

# Option C: OpenAI (paid - only if you add credits)
#   OPENAI_API_KEY=sk-proj-...
#   OPENAI_MODEL=gpt-4o-mini
